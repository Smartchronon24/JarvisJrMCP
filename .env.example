# ==============================================================
# JarvisMCP — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ==============================================================

# --------------------------------------------------------------
# Uber Developer App Credentials
# Obtain from: https://developer.uber.com/dashboard
# --------------------------------------------------------------

UBER_CLIENT_ID =
UBER_CLIENT_SECRET =

# --------------------------------------------------------------
# Uber OAuth Redirect URI
# Must match EXACTLY what is configured in the Uber Developer
# Dashboard under your app's Auth tab.
# For local development: http://localhost:3000/callback
# --------------------------------------------------------------

UBER_REDIRECT_URI=http://localhost:3000/callback

# --------------------------------------------------------------
# Uber Environment
# Use 'sandbox' for development and testing.
# Only switch to 'production' after Uber grants production access.
# --------------------------------------------------------------

UBER_ENVIRONMENT=sandbox

# --------------------------------------------------------------
# Optional — only needed if you use server-to-server requests
# without OAuth. Leave blank for the standard OAuth flow.
# --------------------------------------------------------------

UBER_SERVER_TOKEN=


WHATSAPP_MEDIA_ROOTS=


# --------------------------------------------------------------
# Exa Web Search MCP
# Required for web search and research capabilities.
# --------------------------------------------------------------
EXA_API_KEY=

# --------------------------------------------------------------
# Tavily Search MCP
# Required for web search and extraction capabilities.
# --------------------------------------------------------------
TAVILY_API_KEY=

# --------------------------------------------------------------
# Firecrawl MCP
# Required for web scraping and crawling capabilities.
# --------------------------------------------------------------
FIRECRAWL_API_KEY=