# ==============================================================
# JarvisMCP — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ==============================================================

WHATSAPP_MEDIA_ROOTS=

# LLM provider/model selection.
# Supported providers: ollama (default), gemini, anthropic, openai
# Ollama is the safe default — paid providers are opt-in.
# Role-specific values override the defaults from config/settings.py.
JARVIS_DEFAULT_PROVIDER=ollama
JARVIS_DEFAULT_MODEL=gpt-oss:120b-cloud
JARVIS_ROUTER_PROVIDER=ollama
JARVIS_ROUTER_MODEL=gpt-oss:20b-cloud
JARVIS_WORKER_PROVIDER=ollama
JARVIS_WORKER_MODEL=gpt-oss:120b-cloud

# --------------------------------------------------------------
# LLM Provider API Keys (Phase C.1)
# Leave blank to use Ollama only.
# Keys can also be set at runtime via POST /api/settings/keys/{provider}
# --------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# --------------------------------------------------------------
# Exa Web Search MCP
# Required for web search and research capabilities.
# --------------------------------------------------------------
EXA_API_KEY=

# --------------------------------------------------------------
# Tavily Search MCP
# Required for web search and extraction capabilities.
# --------------------------------------------------------------
TAVILY_API_KEY=

# --------------------------------------------------------------
# Firecrawl MCP
# Required for web scraping and crawling capabilities.
# --------------------------------------------------------------
FIRECRAWL_API_KEY=